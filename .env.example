# ── Lead delivery: Google Sheets ───────────────────────────────────────
# One workbook with four tabs (Enquiries, Webinar Registrations, Corporate Training
# Leads, Consultancy Leads) and one Apps Script (docs/google-apps-script.gs).
# Put the SAME web app URL in both names below. (To use two separate workbooks
# instead, give each name its own URL: Training = enquiries, webinars, corporate.)
GOOGLE_SHEETS_TRAINING_WEBHOOK_URL=
GOOGLE_SHEETS_CONSULTANCY_WEBHOOK_URL=
# Optional but recommended: the same value as the WEBHOOK_SECRET Script Property.
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Old single-sheet setting. Still used as a fallback if the two above are empty.
GOOGLE_SHEETS_WEBHOOK_URL=

# ── Lead delivery: email notification ──────────────────────────────────
# Where webinar / corporate / consultancy lead notifications are sent.
LEAD_NOTIFICATION_EMAIL=support@athenixlearning.com
# Resend API key + verified sender (swap the provider in lib/leadDelivery.ts if needed).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@athenixlearning.com

# ── Cashfree (webinar payments) ─────────────────────────────────────────
# Leave these empty and webinars register WITHOUT payment (status "Registered
# (payment not collected)"). Fill the two keys and the form charges before
# registering. Both come from the Cashfree dashboard: Developers > API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" for testing (default, safe) or "production" for real money.
# Use sandbox keys with sandbox, live keys with production.
CASHFREE_ENV=sandbox
# Optional: the public address of the site (defaults to https://www.athenixlearning.com).
SITE_URL=
