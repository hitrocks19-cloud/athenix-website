# ── Lead delivery ──────────────────────────────────────────────────────
# Apps Script (or similar) webhook URL that appends a row to a Google Sheet.
GOOGLE_SHEETS_WEBHOOK_URL=

# Where webinar / corporate / consultancy lead notifications are sent.
LEAD_NOTIFICATION_EMAIL=support@athenixlearning.com

# SMTP/email provider credentials for sending the lead notification email.
# (Swap this block for whatever provider you actually use — Resend, SES,
# Postmark, SMTP, etc. lib/leadDelivery.ts isolates this so only one file
# needs to change.)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@athenixlearning.com
